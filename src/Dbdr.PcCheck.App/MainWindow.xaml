<Window x:Class="Dbdr.PcCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBDR Anti-Cheat — Evidence Suite"
        Icon="Assets/Brand/DBDRAnticheat.ico"
        Width="1160" Height="790" MinWidth="1000" MinHeight="680"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Height="3" VerticalAlignment="Top"
                Background="{StaticResource Primary}" Panel.ZIndex="10" />

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="Assets/Brand/DBDRAnticheat.png"
                           Width="132" Height="104"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DBDR ANTI-CHEAT" Margin="2,7,0,0"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Primary}" />
                    <TextBlock Text="EVIDENCE SUITE" Margin="0,2,0,0"
                               FontSize="17" FontWeight="SemiBold" />
                    <Border Margin="0,7,0,0" Padding="7,3" HorizontalAlignment="Left"
                            Background="{StaticResource PrimarySoft}"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBlock Text="{Binding DisplayVersion}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                    <TextBlock Text="WORKSPACE" Margin="14,0,0,7"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextQuiet}" />
                    <RadioButton x:Name="SetupNavButton" GroupName="Navigation" Content="NEW CHECK"
                                 Style="{StaticResource NavButtonStyle}" IsChecked="True" />
                    <RadioButton x:Name="ModulesNavButton" GroupName="Navigation" Content="MODULE CATALOG"
                                 Style="{StaticResource NavButtonStyle}" />
                    <RadioButton x:Name="ExplorerNavButton" GroupName="Navigation" Content="EVIDENCE EXPLORER"
                                 Style="{StaticResource NavButtonStyle}" />
                    <RadioButton x:Name="ActivityNavButton" GroupName="Navigation" Content="COLLECTION ACTIVITY"
                                 Style="{StaticResource NavButtonStyle}" />
                    <RadioButton x:Name="PrivacyNavButton" GroupName="Navigation" Content="BOUNDARY &amp; PRIVACY"
                                 Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                             Fill="{StaticResource Success}" VerticalAlignment="Center" />
                    <TextBlock Text="LOCAL · NO UPLOAD" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Success}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="SetupPage" Margin="24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SetupNavButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="AUTHORIZED ENDPOINT REVIEW" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="New authorized check" Margin="0,4,0,0" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Set the time window, confirm scope and collect local read-only evidence."
                               Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Case &amp; review window" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Grid.Column="1" Padding="8,3" Background="{StaticResource PrimarySoft}"
                                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="UTC" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.35*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Case ID" Foreground="{StaticResource TextSecondary}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CaseIdTextBox"
                                                     ToolTip="Letters, numbers, hyphens and underscores only" />
                                            <Button x:Name="CaseIdRefreshButton" Grid.Column="1" Content="Regenerate"
                                                    Margin="8,0,0,0" Style="{StaticResource CompactButtonStyle}"
                                                    Click="CaseIdRefreshButton_OnClick" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Quick window" Foreground="{StaticResource TextSecondary}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button x:Name="LastHourButton" Content="Last hour" Tag="1"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Click="ReviewWindowPresetButton_OnClick" />
                                            <Button x:Name="LastSixHoursButton" Content="Last 6 hours" Tag="6" Margin="7,0,0,0"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Click="ReviewWindowPresetButton_OnClick" />
                                            <Button x:Name="LastDayButton" Content="Last 24 hours" Tag="24" Margin="7,0,0,0"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Click="ReviewWindowPresetButton_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Review start" Foreground="{StaticResource TextSecondary}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ReviewWindowStartDateTextBox" ToolTip="YYYY-MM-DD" />
                                            <TextBox x:Name="ReviewWindowStartTimeTextBox" Grid.Column="1" Margin="8,0,0,0"
                                                     ToolTip="24-hour time, HH:mm" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Review end" Foreground="{StaticResource TextSecondary}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.45*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ReviewWindowEndDateTextBox" ToolTip="YYYY-MM-DD" />
                                            <TextBox x:Name="ReviewWindowEndTimeTextBox" Grid.Column="1" Margin="8,0,0,0"
                                                     ToolTip="24-hour time, HH:mm" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextQuiet}"
                                           Text="Date format: YYYY-MM-DD · time format: HH:mm · stored and filtered in UTC." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Evidence scope" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Live process state is always captured first. Optional sources remain independently cancellable."
                                           Margin="0,5,0,11" Style="{StaticResource MutedTextStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <CheckBox x:Name="LiveStateCheckBox" Content="Live DBD and process state"
                                                  IsChecked="True" IsEnabled="False"
                                                  ToolTip="Processes, loaded DBD modules, hashes and signatures" />
                                        <CheckBox x:Name="ExecutionHistoryCheckBox" Content="Execution timeline" IsChecked="True"
                                                  Margin="0,10,0,0"
                                                  ToolTip="BAM, parsed Prefetch run times, service installs and Code Integrity" />
                                        <CheckBox x:Name="FileEnrichmentCheckBox" Content="Executable metadata" IsChecked="True"
                                                  Margin="0,10,0,0"
                                                  ToolTip="Deduplicated SHA-256, WinVerifyTrust signer details, PE structure/imports and entropy" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="PersistenceCheckBox" Content="Persistence inventory" IsChecked="True"
                                                  ToolTip="Autorun locations, services, configured/loaded drivers and referenced-binary triage" />
                                        <CheckBox x:Name="ScheduledTasksCheckBox" Content="Scheduled tasks" IsChecked="True"
                                                  Margin="0,10,0,0"
                                                  ToolTip="Task names, commands and trigger classes; arguments excluded" />
                                        <CheckBox x:Name="DeviceInventoryCheckBox" Content="Privacy-minimized devices" IsChecked="True"
                                                  Margin="0,10,0,0"
                                                  ToolTip="Device classes and model IDs; serial instance IDs excluded" />
                                        <CheckBox x:Name="ExtendedForensicsCheckBox" Content="Extended forensic metadata" IsChecked="False"
                                                  Margin="0,10,0,0"
                                                  ToolTip="Opt-in Amcache inventory, crash/PowerShell lifecycle and bounded NTFS executable-change history; content and dumps excluded" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Bundle protection" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,5,0,11" Style="{StaticResource MutedTextStyle}"
                                           Text="The exported .dbdr case is authenticated and encrypted locally. The passphrase is required to reopen it and is never written into the bundle." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Case passphrase" Foreground="{StaticResource TextSecondary}" />
                                        <PasswordBox x:Name="BundlePassphrasePasswordBox" Margin="0,6,0,0"
                                                     ToolTip="12–256 characters; not recoverable" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Confirm passphrase" Foreground="{StaticResource TextSecondary}" />
                                        <PasswordBox x:Name="BundlePassphraseConfirmPasswordBox" Margin="0,6,0,0"
                                                     ToolTip="Enter the same case passphrase again" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextQuiet}"
                                           Text="Minimum 12 characters. DBDR cannot recover a lost passphrase." />
                            </StackPanel>
                        </Border>

                        <Expander x:Name="AdvancedTriageExpander" Margin="0,10,0,0"
                                  Header="Advanced triage · YARA and custom rules"
                                  Style="{StaticResource CompactExpanderStyle}">
                            <StackPanel>
                                <TextBlock Text="Entropy is calculated during the existing hash read. YARA scans only approved referenced executables in a killable same-EXE worker with a per-file timeout."
                                           Margin="0,0,0,10" Style="{StaticResource MutedTextStyle}" />
                                <CheckBox x:Name="YaraScanCheckBox" Content="Run embedded DBDR YARA baseline" IsChecked="True" />
                                <Grid Margin="22,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="YaraRulesPathTextBox"
                                             ToolTip="Optional .yar or .yara file; rule contents are not copied into the evidence bundle" />
                                    <Button x:Name="YaraRulesBrowseButton" Grid.Column="1" Content="Choose rules…"
                                            Margin="8,0,0,0" Click="YaraRulesBrowseButton_OnClick" />
                                </Grid>
                                <TextBlock Text="The bundle stores rule IDs and ruleset hashes only. Hits remain review leads."
                                           Margin="22,7,0,0" FontSize="12" Foreground="{StaticResource TextQuiet}" />
                            </StackPanel>
                        </Expander>

                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Authorization" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,5,0,9" Style="{StaticResource MutedTextStyle}"
                                               Text="Read-only system evidence. Selected sources may expose sensitive executable paths and application activity metadata; content, credentials, browser data and memory remain excluded." />
                                    <CheckBox x:Name="ConsentCheckBox">
                                        <TextBlock Text="I authorize this local collection and understand that warnings are review leads, not verdicts."
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                                <Button Grid.Column="1" Content="View boundary" VerticalAlignment="Bottom"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="ReviewBoundaryButton_OnClick" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Local output" FontWeight="SemiBold" />
                            <TextBlock Text="Desktop\DBDR-PC-Checks · encrypted .dbdr · no upload"
                                       Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextQuiet}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="CancelButton" Content="Cancel" Width="88" Margin="0,0,8,0"
                                    IsEnabled="False" Click="CancelButton_OnClick" />
                            <Button x:Name="StartButton" Content="Begin collection" Width="148"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ModuleCatalogPage" Margin="24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ModulesNavButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="PORTABLE MODULE PLATFORM" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="Module catalog" Margin="0,4,0,0" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Runnable modules first. Planned and privacy-gated sources stay out of the operational view by default."
                               Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModuleSearchTextBox"
                             ToolTip="Search module names, categories, capabilities or evidence kinds"
                             TextChanged="ModuleSearchTextBox_OnTextChanged" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="ShowUnavailableModulesCheckBox" Content="Show planned / gated"
                                  Checked="ModuleCatalogFilter_OnChanged"
                                  Unchecked="ModuleCatalogFilter_OnChanged" />
                        <TextBlock x:Name="ModuleCatalogSummaryTextBlock" Margin="22,3,0,0"
                                   FontSize="11" Foreground="{StaticResource TextQuiet}" />
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleModules}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,7" Padding="13"
                                    ToolTip="{Binding Boundary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Category}" Margin="10,3,0,0" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextQuiet}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Margin="0,4,20,0"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                        <Border Padding="8,3" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Access}" Margin="0,5,0,0" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextQuiet}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="EvidenceExplorerPage" Margin="24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ExplorerNavButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NORMALIZED CASE EVIDENCE" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="Evidence explorer" Margin="0,4,0,0" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="BundleVerificationTextBlock"
                                   Text="Search the current run or reopen a verified .dbdr / legacy .zip case."
                                   Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Button x:Name="OpenEvidenceBundleButton" Grid.Column="1" Content="Open verified bundle…"
                            VerticalAlignment="Bottom" Style="{StaticResource CompactButtonStyle}"
                            Click="OpenEvidenceBundleButton_OnClick" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="RECORDS" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="RecordsMetricTextBlock" Text="—" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="NEEDS REVIEW" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="ReviewMetricTextBlock" Text="—" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Warning}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="COVERAGE GAPS" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="CoverageGapMetricTextBlock" Text="—" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="MODULES COMPLETE" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="ModuleCoverageMetricTextBlock" Text="—" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModuleCoverageDetailTextBlock" Text="No case loaded" FontSize="10"
                                       Foreground="{StaticResource TextQuiet}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="SOURCES AVAILABLE" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="SourceCoverageMetricTextBlock" Text="—" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="SourceCoverageDetailTextBlock" Text="No case loaded" FontSize="10"
                                       Foreground="{StaticResource TextQuiet}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.15*" />
                                <RowDefinition Height="0.85*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="15,12,15,9">
                                <TextBlock Text="FINDINGS" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock Text="Select one for its full rationale" HorizontalAlignment="Right"
                                           FontSize="10" Foreground="{StaticResource TextQuiet}" />
                            </Grid>
                            <ListBox x:Name="FindingListBox" Grid.Row="1" ItemsSource="{Binding FindingItems}"
                                     Padding="8,0,8,8" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="FindingListBox_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,5">
                                            <TextBlock Text="{Binding DispositionLabel}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource Primary}" />
                                            <TextBlock Text="{Binding Title}" Margin="0,3,0,0" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ContextLabel}" Margin="0,3,0,0" FontSize="10"
                                                       Foreground="{StaticResource TextQuiet}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource PanelRaised}" Padding="15,11">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="FindingDetailDispositionTextBlock" Text="NO FINDING SELECTED"
                                               Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="FindingDetailTitleTextBlock" Grid.Row="1" Text="No automated findings"
                                               Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FindingDetailContextTextBlock" Grid.Row="2" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextQuiet}" FontSize="10" />
                                    <ScrollViewer Grid.Row="3" Margin="0,7,0,7" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="FindingDetailTextBlock" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Text="This is not a clean verdict. Review source coverage and normalized evidence before reaching any conclusion." />
                                    </ScrollViewer>
                                    <Button x:Name="ScopeFindingButton" Grid.Row="4" Content="Scope records to this finding"
                                            HorizontalAlignment="Left" IsEnabled="False" Style="{StaticResource CompactButtonStyle}"
                                            Click="ScopeFindingButton_OnClick" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Search evidence" Foreground="{StaticResource TextSecondary}" />
                                <TextBox x:Name="EvidenceSearchTextBox" Margin="0,6,0,0"
                                         TextChanged="EvidenceSearchTextBox_OnTextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Module / source / kind" Foreground="{StaticResource TextSecondary}" />
                                <TextBox x:Name="EvidenceModuleScopeTextBox" Margin="0,6,0,0"
                                         ToolTip="Examples: bam, prefetch, devices, file.metadata"
                                         TextChanged="EvidenceSearchTextBox_OnTextChanged" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Clear" VerticalAlignment="Bottom"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ClearEvidenceFiltersButton_OnClick" />
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="15,11,15,7">
                                    <TextBlock Text="NORMALIZED RECORDS" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="EvidenceResultSummaryTextBlock" Text="NO CASE LOADED"
                                               HorizontalAlignment="Right" FontSize="10"
                                               Foreground="{StaticResource TextQuiet}" />
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding EvidenceSearchResults}" Padding="14,8"
                                         Background="Transparent" BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ActivityPage" Margin="24,22">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ActivityNavButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="LIVE CASE TELEMETRY" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="Collection activity" Margin="0,4,0,0" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Every enabled module reports progress and explicit source coverage."
                               Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StatusTextBlock" Text="Ready for an authorized collection" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="CollectionSummaryTextBlock" Text="No bundle has been created in this session."
                                       Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="CollectionProgressBar" Width="160" Height="6" Margin="0,0,14,0"
                                         IsIndeterminate="False" Foreground="{StaticResource Primary}" />
                            <Button x:Name="ActivityCancelButton" Content="Cancel" Width="88" IsEnabled="False"
                                    Click="CancelButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <ListBox x:Name="ActivityListBox" Padding="16,12" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextSecondary}" ItemsSource="{Binding Activity}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Border>
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="LastBundlePathTextBlock" Text="Bundles are written to Desktop\DBDR-PC-Checks."
                               Foreground="{StaticResource TextQuiet}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="OpenLastBundleButton" Content="Open last bundle" HorizontalAlignment="Right"
                            IsEnabled="False" Click="OpenLastBundleButton_OnClick" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="PrivacyPage" Margin="24,22" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=PrivacyNavButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="COLLECTION STANDARD" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="Boundary &amp; privacy" Margin="0,4,0,0" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="The operational boundary, condensed."
                               Margin="0,5,0,18" Style="{StaticResource MutedTextStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,18,18">
                                <TextBlock Text="Read-only scope" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                           Text="Processes, DBD modules, approved execution and persistence metadata, hashes, signatures and privacy-minimized device facts. Opt-in sources add Amcache, crash, PowerShell lifecycle and bounded NTFS executable-change metadata." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,18">
                                <TextBlock Text="Never collected" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                           Text="Credentials, browser URLs/downloads/cookies, chat data, clipboard, screenshots, personal documents, command or script content, unique device serials, crash dumps or process/kernel memory." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,18,0">
                                <TextBlock Text="Interpretation" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                           Text="Warnings and YARA hits are review leads—not cheating verdicts. Missing or inaccessible sources are explicit coverage gaps." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Local handling" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}"
                                           Text="New .dbdr cases are authenticated and encrypted with the case passphrase. The passphrase is not stored or recoverable; keep it separate from the bundle and delete both when retention ends." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
