<Window x:Class="Dbdr.PcCheck.App.BundlePassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open encrypted evidence bundle"
        Width="470" Height="245" MinWidth="470" MinHeight="245"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Border Margin="18" Padding="18" Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Case passphrase" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,11" TextWrapping="Wrap"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Enter the passphrase used when this .dbdr case was created. It is processed locally and is not retained." />
            <PasswordBox x:Name="PassphrasePasswordBox" Grid.Row="2"
                         ToolTip="12–256 characters" />
            <TextBlock x:Name="ValidationTextBlock" Grid.Row="3" Margin="0,7,0,0"
                       Foreground="{StaticResource Warning}" FontSize="12" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" IsCancel="True" />
                <Button Content="Open bundle" Width="112" Margin="8,0,0,0"
                        IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
