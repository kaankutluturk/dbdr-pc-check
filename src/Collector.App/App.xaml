<Application x:Class="Dbdr.PcCheck.Collector.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10151D" />
        <SolidColorBrush x:Key="PanelBackground" Color="#19212C" />
        <SolidColorBrush x:Key="Primary" Color="#D64D5D" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#EC6271" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F5F8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AAB4C0" />
    </Application.Resources>
</Application>
