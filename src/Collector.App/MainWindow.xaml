<Window x:Class="Dbdr.PcCheck.Collector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBDR PC Check Collector — Development Build"
        Width="780" Height="680" MinWidth="700" MinHeight="620"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DBDR PC Check Collector" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Development milestone 0.1 · local evidence only"
                       Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="18" Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="Collection boundary" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                           Text="Collects system metadata, running processes, executable hashes/signature presence, Run keys, services and drivers. It does not collect browser or chat data, credentials, screenshots, personal documents, command lines or process memory. Nothing is uploaded." />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#F2C66D"
                           Text="This is not a cheat verdict. The resulting ZIP is unencrypted development evidence and must be handled confidentially." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="Case ID" FontWeight="SemiBold" />
                <TextBox x:Name="CaseIdTextBox" Margin="0,7,0,0" Height="36" Padding="10,6"
                         Background="#222C38" Foreground="{StaticResource TextPrimary}" BorderBrush="#3B4858"
                         ToolTip="Letters, numbers, hyphens and underscores only" />
                <CheckBox x:Name="ConsentCheckBox" Margin="0,14,0,0" Foreground="{StaticResource TextPrimary}"
                          Content="I have read the collection boundary and authorize this local collection." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="38" Margin="0,0,10,0"
                        IsEnabled="False" Click="CancelButton_OnClick" />
                <Button x:Name="StartButton" Content="Begin PC Check" Width="142" Height="38"
                        Background="{StaticResource Primary}" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Click="StartButton_OnClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontWeight="SemiBold" />
                <ListBox x:Name="ActivityListBox" Grid.Row="1" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                         ItemsSource="{Binding Activity}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Text="Output is written to a DBDR-PC-Checks folder on the current user's Desktop." />
    </Grid>
</Window>
